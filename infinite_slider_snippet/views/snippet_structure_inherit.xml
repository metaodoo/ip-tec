<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="carousal_dashboard" inherit_id="website.snippets" name="Caroudal Dashboard">
        <xpath expr="//div[@id='snippet_effect']/div[hasclass('o_panel_body')]" position="inside">
            <t t-snippet="infinite_slider_snippet.s_carousel_template" t-thumbnail="/infinite_slider_snippet/static/src/image/carousel.png"/>
        </xpath>
    </template>

    <template id="s_carousel_template" name="Logo Carousel">
        <section class="s_carousel_template pt24 pb24">
            <div class="container">

            </div>
        </section>
    </template>

    <template id="s_carousel_inner_items" name="Header Image Footer Card">
        <div class="container">
            <h3 class="text-center mb32">Follow Us On Instagram</h3>

            <div class="row" style="float: left; padding: 10px; height: 400px; width:100%;">
                <t t-foreach="latest_products" t-as="product">
                    <div t-attf-class="d-flex col-12 col-sm-6 col-md-#{int(12 / events_per_slide)}">
                        <ul>
                            <a t-attf-href="https://www.instagram.com/{{product.profile_id.username}}/">
                                <div class="wrapper">
                                    <div class="img_wrapper">
                                        <div class="row align-items-start">
                                            <div class="col" style="height: 150px;">
                                                <img class="img-fluid" loading="lazy" style="height: 304px; width:255px;max-width:none;" t-attf-src="data:image/jpg;base64,{{ product.post_image }}"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </ul>
                    </div>
                </t>
            </div>
        </div>

    </template>

    <template id="s_carousel_template_items">
         <div class="slider">
            <div class="slide-track">
                <!-- ============= to duplicate the image div =============== -->
                <t t-foreach="[1,2]" t-as="i">
                    <!-- ============= to loop through images =============== -->
                    <t t-foreach="objects" t-as="image">
                        <!-- <div class="slide">
                            <img t-att-src="image" class="slider-image"/>
                        </div> -->

                        <!-- Added By RIFAT -->
                        <div class="slide">
                            <a t-att-href="image.get('link')" target="_blank">
                                <img t-att-src="image.get('image_url')" class="slider-image"/>
                            </a>
                        </div>
                    </t>
                </t>
            </div>
         </div>
    </template>
</odoo>