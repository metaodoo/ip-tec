<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Form View   -->
    <record id="instagram_post_view_form" model="ir.ui.view">
        <field name="name">slider.image.form</field>
        <field name="model">slider.image</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title mb24">
                        <h1>
                            <group>
                                <field id="name" class="text-break" name="name" default_focus="1" placeholder="e.g. Company A Logo"/>
                                <!-- added by rifat -->
                                <field id="lnk" name="lnk" placeholder="e.g. Company Link"/>
                                <field id="img_url" name="img_url" placeholder="e.g. Image URl"/>

                            </group>
                        </h1>
                    </div>
                    <field name="image" widget="image"/>
                </sheet>
            </form>
        </field>
    </record>
    <!--    List Menu   -->
    <record id="instagram_post_view_list" model="ir.ui.view">
        <field name="name">slider.image.tree</field>
        <field name="model">slider.image</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!--    Search Menu-->
    <record id="insta_post_search" model="ir.ui.view">
        <field name="name">insta.post.search</field>
        <field name="model">slider.image</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <!--    Action      -->
    <record id="action_website_slider_image" model="ir.actions.act_window">
        <field name="name">Logo Carousal</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">slider.image</field>
        <field name="view_id" eval="False"/>
    </record>

    <!--    Menu      -->
    <menuitem name="Slider"
              id="menu_website_image_slider"
              action="action_website_slider_image"
              parent="website.menu_website_global_configuration"
              sequence="30"
              groups="website.group_website_designer"/>
</odoo>
